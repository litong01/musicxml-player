{
  "name": "@music-i18n/musicxml-player",
  "version": "1.3.0",
  "description": "A TypeScript component that loads and plays MusicXML files in the browser using Web Audio and Web MIDI.",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/musicxml-player.mjs",
      "types": "./build/types/index.d.ts"
    }
  },
  "files": [
    "build"
  ],
  "devDependencies": {
    "@chialab/esbuild-plugin-meta-url": "^0.19.0",
    "@types/node": "^24.7.1",
    "@types/verovio": "^3.13.4",
    "@types/webmidi": "^2.1.0",
    "esbuild": "^0.25.9",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugins-node-modules-polyfill": "^1.6.8",
    "eslint": "^9.13.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5"
  },
  "scripts": {
    "test": "vitest run",
    "build": "./apply-patches.sh && npm run build:lint && npm run build:esm && npm run build:cjs && npm run build:d.ts",
    "build:lint": "eslint --fix {src/*.ts,src/**/*.ts} && prettier --write {src/*.ts,src/**/*.ts}",
    "build:esm": "node esbuild.mjs --format=esm",
    "build:cjs": "node esbuild.mjs --format=cjs",
    "build:d.ts": "tsc --emitDeclarationOnly --outDir build/types",
    "build:snap": "vitest --update",
    "test:type": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:build": "node demo/inject-version.mjs && node demo/generate-files-list.mjs && npx cap sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infojunkie/musicxml-player.git"
  },
  "author": "Karim Ratib <karim.ratib@gmail.com> (https://github.com/infojunkie)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/infojunkie/musicxml-player/issues"
  },
  "homepage": "https://github.com/infojunkie/musicxml-player#readme",
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/preferences": "^8.0.0",
    "@tonejs/midi": "^2.0.28",
    "fast-xml-parser": "^4.5.0",
    "opensheetmusicdisplay": "^1.7.1",
    "spessasynth_core": "^4.0.0",
    "spessasynth_lib": "^4.0.0",
    "unzipit": "^1.4.3",
    "verovio": "npm:@music-i18n/verovio@^1.0.0"
  }
}
