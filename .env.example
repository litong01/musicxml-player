# Kinde Authentication Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Your Kinde application client ID
# Get this from: Kinde Dashboard > Settings > Applications > Your App > Details
KINDE_CLIENT_ID=

# Your Kinde domain
# Format: https://yoursubdomain.kinde.com
KINDE_DOMAIN=

# Optional: API audience identifier
# Leave empty if not using a custom API
KINDE_AUDIENCE=

# Server port (optional)
PORT=8082
